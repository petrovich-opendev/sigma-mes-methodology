{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "functional-architecture.schema.json",
  "title": "Шапка артефакта functional-architecture",
  "description": "Шапка артефакта «functional-architecture». Правила, проверяемые check_normative.py: если approval.recorded = true, то statement и date обязательны; в тексте нет кодов из deprecated.yaml; у каждого объекта заполнен authoritative_state_source (RULE-DATA-001); interactions.via только interface, event или reference (RULE-SCOPE-001); предупреждение при словах из normative-checks.yaml fa_technical_markers вне раздела «Передать».",
  "type": "object",
  "properties": {
    "artifact_type": {
      "type": "string",
      "description": "имя типа из этого файла",
      "const": "functional-architecture"
    },
    "artifact_id": {
      "type": "string",
      "description": "по id_pattern типа",
      "pattern": "^FA-M(0[1-9]|1[0-3])$|^FA-[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "description": "номер редакции проекта материала, например 0.1"
    },
    "ai_assistance": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "const": "sigma-mes-skills"
        },
        "plugin_version": {
          "type": "string",
          "const": "0.11.0"
        },
        "constitution_version": {
          "type": "string",
          "description": "из шага S4"
        },
        "active_role": {
          "type": "string",
          "pattern": "^ROLE-[A-Z-]+$"
        },
        "prepared_by_ai": {
          "type": "boolean",
          "const": true
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "description": "путь@редакция или коммит"
              },
              "element": {
                "type": "string",
                "description": "RULE-…, TERM-…, раздел, идентификатор артефакта"
              }
            },
            "required": [
              "ref",
              "element"
            ]
          },
          "minItems": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "пустой список допустим; фраза «Основания в действующих материалах нет: …»"
        },
        "approval": {
          "type": "object",
          "properties": {
            "required_role": {
              "type": "string",
              "pattern": "^ROLE-[A-Z-]+$"
            },
            "recorded": {
              "type": "boolean"
            },
            "statement": {
              "type": "string",
              "description": "дословная цитата реплики; обязательна, если recorded = true"
            },
            "date": {
              "type": "string",
              "description": "ГГГГ-ММ-ДД; обязательна, если recorded = true"
            }
          },
          "required": [
            "required_role",
            "recorded"
          ],
          "if": {
            "properties": {
              "recorded": {
                "const": true
              }
            },
            "required": [
              "recorded"
            ]
          },
          "then": {
            "required": [
              "statement",
              "date"
            ]
          }
        }
      },
      "required": [
        "plugin",
        "plugin_version",
        "constitution_version",
        "active_role",
        "prepared_by_ai",
        "basis",
        "gaps",
        "approval"
      ]
    },
    "module": {
      "type": "string",
      "description": "M01–M13 или функциональная область"
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "primary_module": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          },
          "roles_rights": {
            "type": "array"
          },
          "scenarios": {
            "type": "object",
            "properties": {
              "main": {
                "type": "string"
              },
              "alternative": {
                "type": "array"
              },
              "exceptional": {
                "type": "array"
              }
            },
            "required": []
          }
        },
        "required": []
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "term_ref": {
            "type": "string"
          },
          "primary_module": {
            "type": "string"
          },
          "data_responsible_module": {
            "type": "string"
          },
          "authoritative_state_source": {
            "type": "string"
          },
          "attributes": {
            "type": "array"
          },
          "validation_rules": {
            "type": "array"
          },
          "states": {
            "type": "array"
          },
          "transitions": {
            "type": "array"
          },
          "retention": {
            "type": "string"
          }
        },
        "required": [
          "authoritative_state_source"
        ]
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "with_module": {
            "type": "string"
          },
          "via": {
            "type": "string",
            "enum": [
              "interface",
              "event",
              "reference"
            ]
          },
          "business_entities": {
            "type": "array"
          }
        },
        "required": []
      }
    },
    "external_exchange": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string"
          },
          "business_entities": {
            "type": "array"
          },
          "events": {
            "type": "array"
          },
          "rules": {
            "type": "array"
          },
          "degraded_mode": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "ui": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screen": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "roles": {
            "type": "array"
          },
          "zones": {
            "type": "array"
          },
          "actions": {
            "type": "array"
          },
          "wireframe": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "quality_requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^QR-\\d{3,}$"
      }
    }
  },
  "required": [
    "artifact_type",
    "artifact_id",
    "title",
    "product_id",
    "revision",
    "ai_assistance",
    "module",
    "functions",
    "objects",
    "interactions",
    "external_exchange"
  ],
  "additionalProperties": true
}
