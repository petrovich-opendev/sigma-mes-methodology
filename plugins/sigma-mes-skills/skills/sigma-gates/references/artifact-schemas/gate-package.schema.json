{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-package.schema.json",
  "title": "Шапка артефакта gate-package",
  "description": "Шапка артефакта «gate-package». Правила, проверяемые check_normative.py: если approval.recorded = true, то statement и date обязательны; в тексте нет кодов из deprecated.yaml; go_excluded = true тогда и только тогда; когда blocking_items не пуст; approval.required_role = responsible_role; recorded = false всегда.",
  "type": "object",
  "properties": {
    "artifact_type": {
      "type": "string",
      "description": "имя типа из этого файла",
      "const": "gate-package"
    },
    "artifact_id": {
      "type": "string",
      "description": "по id_pattern типа",
      "pattern": "^GP-GATE-0[1-6]-[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "description": "номер редакции проекта материала, например 0.1"
    },
    "ai_assistance": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "const": "sigma-mes-skills"
        },
        "plugin_version": {
          "type": "string",
          "const": "0.11.1"
        },
        "constitution_version": {
          "type": "string",
          "description": "из шага S4"
        },
        "active_role": {
          "type": "string",
          "pattern": "^ROLE-[A-Z-]+$"
        },
        "prepared_by_ai": {
          "type": "boolean",
          "const": true
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "description": "путь@редакция или коммит"
              },
              "element": {
                "type": "string",
                "description": "RULE-…, TERM-…, раздел, идентификатор артефакта"
              }
            },
            "required": [
              "ref",
              "element"
            ]
          },
          "minItems": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "пустой список допустим; фраза «Основания в действующих материалах нет: …»"
        },
        "approval": {
          "type": "object",
          "properties": {
            "required_role": {
              "type": "string",
              "pattern": "^ROLE-[A-Z-]+$"
            },
            "recorded": {
              "type": "boolean"
            },
            "statement": {
              "type": "string",
              "description": "дословная цитата реплики; обязательна, если recorded = true"
            },
            "date": {
              "type": "string",
              "description": "ГГГГ-ММ-ДД; обязательна, если recorded = true"
            }
          },
          "required": [
            "required_role",
            "recorded"
          ],
          "if": {
            "properties": {
              "recorded": {
                "const": true
              }
            },
            "required": [
              "recorded"
            ]
          },
          "then": {
            "required": [
              "statement",
              "date"
            ]
          }
        }
      },
      "required": [
        "plugin",
        "plugin_version",
        "constitution_version",
        "active_role",
        "prepared_by_ai",
        "basis",
        "gaps",
        "approval"
      ]
    },
    "gate": {
      "type": "string",
      "enum": [
        "GATE-01",
        "GATE-02",
        "GATE-03",
        "GATE-04",
        "GATE-05",
        "GATE-06"
      ]
    },
    "evaluated_result": {
      "type": "string"
    },
    "responsible_role": {
      "type": "string",
      "description": "из stages_gates"
    },
    "required_conclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "traceability_breaks": {
      "type": "array"
    },
    "status_discrepancies": {
      "type": "array"
    },
    "acceptance_outcomes": {
      "type": "array",
      "description": "для GATE-03 и GATE-04"
    },
    "blocking_items": {
      "type": "array"
    },
    "go_excluded": {
      "type": "boolean"
    }
  },
  "required": [
    "artifact_type",
    "artifact_id",
    "title",
    "product_id",
    "revision",
    "ai_assistance",
    "gate",
    "evaluated_result",
    "responsible_role",
    "required_conclusions",
    "evidence",
    "traceability_breaks",
    "status_discrepancies",
    "blocking_items",
    "go_excluded"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "go_excluded": {
            "const": true
          }
        },
        "required": [
          "go_excluded"
        ]
      },
      "then": {
        "properties": {
          "blocking_items": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "go_excluded": {
            "const": false
          }
        },
        "required": [
          "go_excluded"
        ]
      },
      "then": {
        "properties": {
          "blocking_items": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
