{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "functional-requirement.schema.json",
  "title": "Шапка артефакта functional-requirement",
  "description": "Шапка артефакта «functional-requirement». Правила, проверяемые check_normative.py: если approval.recorded = true, то statement и date обязательны; в тексте нет кодов из deprecated.yaml; включение фиксируется через approval с required_role = ROLE-FUNCTIONAL-ARCHITECT.",
  "type": "object",
  "properties": {
    "artifact_type": {
      "type": "string",
      "description": "имя типа из этого файла",
      "const": "functional-requirement"
    },
    "artifact_id": {
      "type": "string",
      "description": "по id_pattern типа",
      "pattern": "^FR-M(0[1-9]|1[0-3])-\\d{3}$|^FR-[a-z0-9-]+-\\d{3}$"
    },
    "title": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "description": "номер редакции проекта материала, например 0.1"
    },
    "ai_assistance": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "const": "sigma-mes-skills"
        },
        "plugin_version": {
          "type": "string",
          "const": "0.11.3"
        },
        "constitution_version": {
          "type": "string",
          "description": "из шага S4"
        },
        "active_role": {
          "type": "string",
          "pattern": "^ROLE-[A-Z-]+$"
        },
        "prepared_by_ai": {
          "type": "boolean",
          "const": true
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "description": "путь@редакция или коммит"
              },
              "element": {
                "type": "string",
                "description": "RULE-…, TERM-…, раздел, идентификатор артефакта"
              }
            },
            "required": [
              "ref",
              "element"
            ]
          },
          "minItems": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "пустой список допустим; фраза «Основания в действующих материалах нет: …»"
        },
        "approval": {
          "type": "object",
          "properties": {
            "required_role": {
              "type": "string",
              "pattern": "^ROLE-[A-Z-]+$",
              "const": "ROLE-FUNCTIONAL-ARCHITECT"
            },
            "recorded": {
              "type": "boolean"
            },
            "statement": {
              "type": "string",
              "description": "дословная цитата реплики; обязательна, если recorded = true"
            },
            "date": {
              "type": "string",
              "description": "ГГГГ-ММ-ДД; обязательна, если recorded = true"
            }
          },
          "required": [
            "required_role",
            "recorded"
          ],
          "if": {
            "properties": {
              "recorded": {
                "const": true
              }
            },
            "required": [
              "recorded"
            ]
          },
          "then": {
            "required": [
              "statement",
              "date"
            ]
          }
        }
      },
      "required": [
        "plugin",
        "plugin_version",
        "constitution_version",
        "active_role",
        "prepared_by_ai",
        "basis",
        "gaps",
        "approval"
      ]
    },
    "statement": {
      "type": "string"
    },
    "fa_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "proposed_by": {
      "type": "string"
    },
    "affected_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artifact_type",
    "artifact_id",
    "title",
    "product_id",
    "revision",
    "ai_assistance",
    "statement",
    "fa_refs",
    "source",
    "rationale",
    "acceptance_criteria",
    "proposed_by",
    "affected_modules"
  ],
  "additionalProperties": true
}
