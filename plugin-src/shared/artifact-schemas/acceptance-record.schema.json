{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-record.schema.json",
  "title": "Шапка артефакта acceptance-record",
  "description": "Шапка артефакта «acceptance-record». Правила, проверяемые check_normative.py: если approval.recorded = true, то statement и date обязательны; в тексте нет кодов из deprecated.yaml; исход приёмки недопустим при отсутствии tests_pass_ref или developer_description_ref (RULE-ACCEPTANCE-004); без них запись готовится как проект; outcome = ACCEPTED_WITH_REMARKS требует remarks_as_work_items; outcome = REJECTED_ARCHITECTURALLY требует after_rejection_decision (RULE-FA-CHANGE-002).",
  "type": "object",
  "properties": {
    "artifact_type": {
      "type": "string",
      "description": "имя типа из этого файла",
      "const": "acceptance-record"
    },
    "artifact_id": {
      "type": "string",
      "description": "по id_pattern типа",
      "pattern": "^ACC-\\d{4}$"
    },
    "title": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "description": "номер редакции проекта материала, например 0.1"
    },
    "ai_assistance": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "const": "sigma-mes-skills"
        },
        "plugin_version": {
          "type": "string",
          "const": "0.11.4"
        },
        "constitution_version": {
          "type": "string",
          "description": "из шага S4"
        },
        "active_role": {
          "type": "string",
          "pattern": "^ROLE-[A-Z-]+$"
        },
        "prepared_by_ai": {
          "type": "boolean",
          "const": true
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "description": "путь@редакция или коммит"
              },
              "element": {
                "type": "string",
                "description": "RULE-…, TERM-…, раздел, идентификатор артефакта"
              }
            },
            "required": [
              "ref",
              "element"
            ]
          },
          "minItems": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "пустой список допустим; фраза «Основания в действующих материалах нет: …»"
        },
        "approval": {
          "type": "object",
          "properties": {
            "required_role": {
              "type": "string",
              "pattern": "^ROLE-[A-Z-]+$"
            },
            "recorded": {
              "type": "boolean"
            },
            "statement": {
              "type": "string",
              "description": "дословная цитата реплики; обязательна, если recorded = true"
            },
            "date": {
              "type": "string",
              "description": "ГГГГ-ММ-ДД; обязательна, если recorded = true"
            }
          },
          "required": [
            "required_role",
            "recorded"
          ],
          "if": {
            "properties": {
              "recorded": {
                "const": true
              }
            },
            "required": [
              "recorded"
            ]
          },
          "then": {
            "required": [
              "statement",
              "date"
            ]
          }
        }
      },
      "required": [
        "plugin",
        "plugin_version",
        "constitution_version",
        "active_role",
        "prepared_by_ai",
        "basis",
        "gaps",
        "approval"
      ]
    },
    "functionality": {
      "type": "string"
    },
    "acceptance_scope": {
      "type": "string",
      "enum": [
        "локальная",
        "сквозная"
      ],
      "description": "TERM-FUNCTIONAL-ACCEPTANCE"
    },
    "fr_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "fa_revision": {
      "type": "string"
    },
    "prerequisites": {
      "type": "object",
      "properties": {
        "tests_pass_ref": {
          "type": "string"
        },
        "developer_description_ref": {
          "type": "string"
        },
        "differences_from_fa": {
          "type": "array"
        }
      }
    },
    "step_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "pattern": "^ACC-STEP-(0[1-9])$"
          },
          "checked": {
            "type": "string"
          },
          "findings": {
            "type": "string"
          },
          "refs": {
            "type": "array"
          }
        },
        "required": []
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "ACCEPTED_WITH_REMARKS",
        "RETURNED",
        "REJECTED_ARCHITECTURALLY"
      ],
      "description": "заполняется только при approval.recorded = true"
    },
    "remarks_as_work_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "after_rejection_decision": {
      "type": "string",
      "enum": [
        "переделать реализацию",
        "изменить функциональную архитектуру"
      ]
    }
  },
  "required": [
    "artifact_type",
    "artifact_id",
    "title",
    "product_id",
    "revision",
    "ai_assistance",
    "functionality",
    "acceptance_scope",
    "fr_refs",
    "fa_revision",
    "prerequisites",
    "step_results"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ACCEPTED_WITH_REMARKS"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "remarks_as_work_items"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "REJECTED_ARCHITECTURALLY"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "after_rejection_decision"
        ]
      }
    }
  ]
}
