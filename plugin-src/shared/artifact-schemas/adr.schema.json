{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr.schema.json",
  "title": "Шапка артефакта adr",
  "description": "Шапка артефакта «adr». Правила, проверяемые check_normative.py: если approval.recorded = true, то statement и date обязательны; в тексте нет кодов из deprecated.yaml; significance = высокая требует не меньше двух alternatives.",
  "type": "object",
  "properties": {
    "artifact_type": {
      "type": "string",
      "description": "имя типа из этого файла",
      "const": "adr"
    },
    "artifact_id": {
      "type": "string",
      "description": "по id_pattern типа",
      "pattern": "^ADR-\\d{4}$"
    },
    "title": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "description": "номер редакции проекта материала, например 0.1"
    },
    "ai_assistance": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "const": "sigma-mes-skills"
        },
        "plugin_version": {
          "type": "string",
          "const": "0.11.3"
        },
        "constitution_version": {
          "type": "string",
          "description": "из шага S4"
        },
        "active_role": {
          "type": "string",
          "pattern": "^ROLE-[A-Z-]+$"
        },
        "prepared_by_ai": {
          "type": "boolean",
          "const": true
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "description": "путь@редакция или коммит"
              },
              "element": {
                "type": "string",
                "description": "RULE-…, TERM-…, раздел, идентификатор артефакта"
              }
            },
            "required": [
              "ref",
              "element"
            ]
          },
          "minItems": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "пустой список допустим; фраза «Основания в действующих материалах нет: …»"
        },
        "approval": {
          "type": "object",
          "properties": {
            "required_role": {
              "type": "string",
              "pattern": "^ROLE-[A-Z-]+$"
            },
            "recorded": {
              "type": "boolean"
            },
            "statement": {
              "type": "string",
              "description": "дословная цитата реплики; обязательна, если recorded = true"
            },
            "date": {
              "type": "string",
              "description": "ГГГГ-ММ-ДД; обязательна, если recorded = true"
            }
          },
          "required": [
            "required_role",
            "recorded"
          ],
          "if": {
            "properties": {
              "recorded": {
                "const": true
              }
            },
            "required": [
              "recorded"
            ]
          },
          "then": {
            "required": [
              "statement",
              "date"
            ]
          }
        }
      },
      "required": [
        "plugin",
        "plugin_version",
        "constitution_version",
        "active_role",
        "prepared_by_ai",
        "basis",
        "gaps",
        "approval"
      ]
    },
    "context": {
      "type": "string"
    },
    "answers_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "FR-…, QR-…, FA-…, TC-…"
    },
    "value": {
      "type": "string"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option": {
            "type": "string"
          },
          "pros": {
            "type": "array"
          },
          "cons": {
            "type": "array"
          }
        },
        "required": []
      },
      "minItems": 1
    },
    "decision": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "расчёт",
              "проверка прототипа",
              "испытание",
              "иные проверяемые данные"
            ]
          },
          "ref": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "significance": {
      "type": "string",
      "enum": [
        "высокая",
        "средняя",
        "низкая"
      ]
    },
    "unproven": {
      "type": "boolean",
      "description": "true, если evidence пуст"
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artifact_type",
    "artifact_id",
    "title",
    "product_id",
    "revision",
    "ai_assistance",
    "context",
    "answers_to",
    "value",
    "alternatives",
    "decision",
    "evidence",
    "significance",
    "unproven",
    "consequences"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "significance": {
            "const": "высокая"
          }
        },
        "required": [
          "significance"
        ]
      },
      "then": {
        "properties": {
          "alternatives": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
